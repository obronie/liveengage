# LiveEngage / LearnBlended Poll Environment Configuration

# 1. Supabase Configuration (Optional for local/demo mode, required for cloud production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Google Gemini API Key (For AI Question Generator with Structured Outputs)
GEMINI_API_KEY=your-gemini-api-key-here
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here

# 3. Base App URL (Used for generating Room QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000
